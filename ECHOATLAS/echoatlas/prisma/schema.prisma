// EchoAtlas Prisma schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  profileImage String?
  bio          String?
  location     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  echoes       Echo[]
  likes        Like[]
  comments     Comment[]
  followers    Follow[] @relation("following")
  following    Follow[] @relation("follower")
  notifications Notification[]
  reports      Report[]
  collections  Collection[]
  trails       Trail[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Echo {
  id               String   @id @default(cuid())
  title            String
  story            String
  mood             String   // Happy, Nostalgic, etc.
  historicalPeriod String?
  visibility       String   @default("Public") // Public, Followers only, Private
  latitude         Float
  longitude        Float
  address          String?
  city             String?
  country          String?
  date             DateTime?
  approximateYear  Int?
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  viewCount        Int      @default(0)

  media            EchoMedia[]
  tags             EchoTag[]
  likes            Like[]
  comments         Comment[]
  bookmarks        Bookmark[]
  thenVsNow        HistoricalComparison?
  trailStops       TrailStop[]

  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([authorId])
  @@index([city])
}

model EchoMedia {
  id        String   @id @default(cuid())
  echoId    String
  echo      Echo     @relation(fields: [echoId], references: [id], onDelete: Cascade)
  url       String
  type      String   // image, video, audio
  createdAt DateTime @default(now())
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  echoes EchoTag[]
}

model EchoTag {
  id     String @id @default(cuid())
  echoId String
  tagId  String
  echo   Echo @relation(fields: [echoId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([echoId, tagId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  echoId    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  echo      Echo @relation(fields: [echoId], references: [id], onDelete: Cascade)

  @@unique([userId, echoId])
  @@index([echoId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  echoId    String
  content   String
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  echo      Echo @relation(fields: [echoId], references: [id], onDelete: Cascade)

  @@index([echoId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Bookmark[]

  @@unique([userId, name])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  echoId       String
  collectionId String?
  createdAt    DateTime @default(now())
  echo         Echo @relation(fields: [echoId], references: [id], onDelete: Cascade)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, echoId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  echoId    String?
  type      String   // like, comment, follow, bookmark, milestone
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  echoId      String?
  targetUserId String?
  reason      String
  description String?
  status      String   @default("pending") // pending, reviewed, resolved, dismissed
  createdAt   DateTime @default(now())
  reporter    User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model HistoricalComparison {
  id        String @id @default(cuid())
  echoId    String @unique
  echo      Echo   @relation(fields: [echoId], references: [id], onDelete: Cascade)
  thenImage String
  nowImage  String
  thenYear  Int
  nowYear   Int
}

model Trail {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  stops       TrailStop[]
}

model TrailStop {
  id      String @id @default(cuid())
  trailId String
  echoId  String
  order   Int
  trail   Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  echo    Echo  @relation(fields: [echoId], references: [id], onDelete: Cascade)

  @@unique([trailId, order])
  @@unique([trailId, echoId])
}
